;; Level 5: Full Hybrid with Creative Path
;; Gate now chooses between legacy (stable) and creative (XOR)
;; This is the first level where behavior SHOULD differ from legacy

{:meta {:id :level-5-creative
        :level 5
        :label "Legacy + diversity + gate + creative"
        :description "Full boundary-guardian pattern. Gate chooses legacy vs creative based on diversity."
        :additions [:creative-path :conditional-behavior]
        :expected "Behavior SHOULD differ from Level 4. If same, creative path isn't activating."

        ;; --- UNIFIED FOOTING (2026-07-14) --------------------------------- ;;
        ;; Leg 2 of 3: the CT-backed model this design occupies, the way
        ;; MetaCATokamakExample.lean specifies the tokamak. AIF-COMPLIANCE §25:
        ;; "generators, evaluators, and the Tokamak are one comb — the
        ;; distinction is WIRING, not species." This is an occupant of the
        ;; generator comb, with a COMPOSITE fill at the combine hole.
        :ct-model
        {:lean "DarkTower/MetaCAExample.lean"
         :comb "cellUpdate"    ; (readPhe ⅋ readL ⅋ readC ⅋ readR) ◁ combine ◁ mutate ◁ write
         :occupant
         {:read-phenotype-context :active        ; :ctx-phe feeds the legacy kernel
          :read-left-rule  :neighbour-rule       ; :ctx-pred
          :read-center-rule :self-rule           ; :ctx-self
          :read-right-rule :neighbour-rule       ; :ctx-succ
          ;; The combine hole is filled by a GATED CHOICE between two
          ;; sub-combines — this is what makes L5 a composite occupant rather
          ;; than a leaf one, and is the structure the ladder builds up to.
          :combine {:gate :threshold-sigil
                    :on :diversity                ; diversity of :context-neighbors
                    :threshold 0.5
                    :below :legacy-kernel-step    ; exploit  (工/super params)
                    :above :bit-xor}              ; explore  (creative path)
          :mutate  :none
          :write   :output-sigil}
         :differs-from {:level-4-gate [:combine]} ; L4's gate exists but always
                                                  ; selects :below; L5 fills :above
         :note
         "Feed-forward per cell-step: the gate SELECTS between sub-combines, it
          does not feed a later stage back into an earlier port. The
          open-diagram (Comb.lean coend) layer is NOT triggered."}

        ;; Leg 3 of 3: reproducibility. HONEST CAVEAT — this design is only
        ;; PARTLY reproducible, and r01 says so itself.
        :reproducibility
        {:runtime "futon5.wiring.runtime (headless)"
         :standard-protocol {:seeds [4242 238310129 352362012]   ; ladder README
                             :widths [100 120]
                             :generations 100}
         :status :partial
         :caveat
         "r01_boundary_guardian's cross-check: the CREATIVE path is grid-identical
          (18K+ checks, 0 errors) but the LEGACY path is only statistical — it
          uses unseeded `rand`. So per-seed reproducibility does NOT hold for the
          legacy sub-combine. Same global-RNG defect found in the tokamak's
          run-mmca. Fixing it = threading a seeded rng through the legacy kernel."
         :replay "notebooks/sci-repro/notebooks/r01_boundary_guardian.clj"}

        ;; Why this member matters to the cohort.
        :cohort-note
        "r01 records this as 'the only genotype-layer edge-of-chaos run ever
         recorded in the futon5 repo' — strong EoC diagnostics, yet only 0.176 on
         the standard verifier. That tension makes it the prime anchor candidate
         for validating Cμ against the eye: if a measure calls this EoC, it agrees
         with the visual read that the verifier missed."}

 :diagram
 {:nodes [;; Context extraction
          {:id :ctx-pred :component :context-pred}
          {:id :ctx-self :component :context-self}
          {:id :ctx-succ :component :context-succ}
          {:id :ctx-prev :component :context-prev}
          {:id :ctx-phe :component :context-phe}
          {:id :neighbors :component :context-neighbors}

          ;; Diversity measurement
          {:id :diversity :component :diversity}

          ;; Legacy kernel (stable path)
          {:id :legacy :component :legacy-kernel-step
           :params {:kernel :mutating-template
                    :exotype-sigil "工"
                    :exotype-tier :super
                    :exotype-params {:rotation 0
                                     :match-threshold 0.4444444444444444
                                     :invert-on-phenotype? false
                                     :update-prob 0.5
                                     :mix-mode :rotate-left
                                     :mix-shift 0}}}

          ;; NEW: Creative path (XOR of neighbors)
          {:id :creative :component :bit-xor}

          ;; Gate: diversity > 0.5 → creative, else legacy
          {:id :gate :component :threshold-sigil}

          {:id :out :component :output-sigil}]

  :edges [;; Diversity measurement
          {:from :neighbors :from-port :sigils :to :diversity :to-port :sigils}

          ;; Legacy path
          {:from :ctx-pred :from-port :sigil :to :legacy :to-port :pred}
          {:from :ctx-self :from-port :sigil :to :legacy :to-port :self}
          {:from :ctx-succ :from-port :sigil :to :legacy :to-port :succ}
          {:from :ctx-prev :from-port :sigil :to :legacy :to-port :prev}
          {:from :ctx-phe :from-port :bits :to :legacy :to-port :phe}

          ;; Creative path: XOR of neighbors
          {:from :ctx-pred :from-port :sigil :to :creative :to-port :a}
          {:from :ctx-succ :from-port :sigil :to :creative :to-port :b}

          ;; Gate: high diversity → creative, low diversity → legacy
          {:from :diversity :from-port :score :to :gate :to-port :score}
          {:value 0.5 :value-type :scalar :to :gate :to-port :threshold}
          {:from :creative :from-port :result :to :gate :to-port :above}  ;; High diversity → creative
          {:from :legacy :from-port :result :to :gate :to-port :below}    ;; Low diversity → legacy

          {:from :gate :from-port :result :to :out :to-port :sigil}]

  :output :out}}
