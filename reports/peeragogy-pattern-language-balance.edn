icture.…"} {:from "wrapper", :to "scrapbook", :from-title "Wrapper", :to-title "Scrapbook", :section "Solution", :whats-next? false, :sign :positive, :quote "…any problems they are running into. Between meetings, each participant is advised to maintain some sort of \"learning log\" in the form of a personal [[file:scrapbook.org][Scrapbook]], so that outstanding concerns are surfaced and available to discuss.…"}), :undirected-edges ({:a "carrying", :b "heartbeat", :sign :positive, :section "Rationale", :citations [[nil nil]], :mixed-signs? false} {:a "carrying", :b "roadmap", :sign :positive, :section "Solution                                                             :key:", :citations [[nil nil]], :mixed-signs? false} {:a "distributed_roadmap", :b "specific", :sign :positive, :section "What's Next", :citations [[nil nil]], :mixed-signs? false} {:a "heartbeat", :b "roadmap", :sign :positive, :section "Rationale", :citations [[nil nil]], :mixed-signs? false} {:a "heartbeat", :b "scrapbook", :sign :negative, :section "Resolution", :citations [[nil nil]], :mixed-signs? false} {:a "newcomer", :b "reduce", :sign :positive, :section "Problem", :citations [[nil nil]], :mixed-signs? false} {:a "newcomer", :b "roadmap", :sign :positive, :section "Solution", :citations [[nil nil]], :mixed-signs? false} {:a "newcomer", :b "scrapbook", :sign :positive, :section "Solution", :citations [[nil nil]], :mixed-signs? false} {:a "pattern_audit", :b "specific", :sign :positive, :section "What's Next", :citations [[nil nil]], :mixed-signs? false} {:a "peeragogy", :b "specific", :sign :positive, :section "Solution", :citations [[nil nil]], :mixed-signs? false} {:a "reduce", :b "scrapbook", :sign :positive, :section "Solution", :citations [[nil nil]], :mixed-signs? false} {:a "roadmap", :b "specific", :sign :positive, :section "Solution", :citations [[nil nil]], :mixed-signs? false} {:a "roadmap", :b "wrapper", :sign :positive, :section "Solution", :citations [[nil nil]], :mixed-signs? f